<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HypervisorExplorer.App.ViewModels"
        x:Class="HypervisorExplorer.App.Views.ConnectDialog"
        x:DataType="vm:ConnectDialogViewModel"
        Title="{Binding Title}" Width="520" Height="640" MinHeight="560" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,8,20,16" >
            <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
            <Button Classes="primary" Content="{Binding PrimaryButtonText}" Click="OnOk" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer>
            <StackPanel Margin="20,20,20,8" Spacing="10">
                <TextBlock Classes="h1" Text="{Binding Title}"/>

                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="Platform" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ConnectDialogViewModel.PlatformOptions}"
                              SelectedItem="{Binding SelectedPlatform}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:PlatformOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="Host" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,8,90">
                        <TextBox x:Name="AddressBox" Text="{Binding Address}" PlaceholderText="hostname, FQDN or IP"/>
                        <TextBox Grid.Column="2" Text="{Binding Port}" PlaceholderText="{Binding PortPlaceholder}" ToolTip.Tip="Port (blank = default)"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Name" VerticalAlignment="Center" IsVisible="{Binding EditOnly}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DisplayName}" PlaceholderText="optional friendly name" IsVisible="{Binding EditOnly}"/>

                    <TextBlock Grid.Row="3" Text="Group" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                              ToolTip.Tip="Groups label hosts (shown as the RVTools 'Datacenter') and can supply shared credentials">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:GroupOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Sign in with" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CredentialOptions}" SelectedItem="{Binding SelectedCredential}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:CredentialOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="5" Text="{Binding UsernameLabel}" VerticalAlignment="Center" IsVisible="{Binding NeedsCredentials}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Username}" PlaceholderText="{Binding UsernameWatermark}" IsVisible="{Binding NeedsCredentials}"/>

                    <TextBlock Grid.Row="6" Text="{Binding SecretLabel}" VerticalAlignment="Center" IsVisible="{Binding NeedsCredentials}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Secret}" PasswordChar="●" RevealPassword="False" IsVisible="{Binding NeedsCredentials}"
                             PlaceholderText="{Binding InheritsFromGroup, Converter={x:Static vm:Converters.GroupSecretWatermark}}"/>
                </Grid>

                <StackPanel Spacing="4" Margin="120,0,0,0">
                    <CheckBox Content="Save credentials (encrypted for your user account)" IsChecked="{Binding SaveCredentials}" IsVisible="{Binding NeedsCredentials}"/>
                    <CheckBox Content="Accept self-signed certificates" IsChecked="{Binding IgnoreCertificateErrors}" IsVisible="{Binding ShowsCertificateOption}"/>
                    <CheckBox Content="Use HTTPS for WinRM (port 5986)" IsChecked="{Binding UseSsl}" IsVisible="{Binding IsHyperV}"/>
                    <CheckBox Content="Collect all Failover Cluster nodes" IsChecked="{Binding ExpandCluster}" IsVisible="{Binding IsHyperV}"/>
                </StackPanel>

                <Border Background="#1F2638" CornerRadius="6" Padding="10">
                    <TextBlock Classes="subtle" Text="{Binding Hint}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
