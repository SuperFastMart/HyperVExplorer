# Normalise line endings in the repo; Windows scripts check out as CRLF
* text=auto
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cs   text eol=crlf
*.xaml text eol=crlf
*.sln  text eol=crlf
*.csproj text eol=crlf

*.exe  binary
*.dll  binary
*.xlsx binary
*.png  binary
*.ico  binary
